[Unit]
Description=SN Monitor (RTSP -> PP-OCR) small-board persistent
After=network-online.target
Wants=network-online.target
# 单客户端摄像头源同一路只能一个进程拉流: 与 big 档服务互斥, 启一个自动停另一个, 杜绝抢流打架
Conflicts=sn-monitor-big.service
# ★ V3.0.1: start 时自动拉起 uploader sidecar（uploader 起不来不阻塞识别）
Wants=sn-uploader.service

[Service]
Type=simple
User=root
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/data/soph_SN
# --idle 0: 永不因空闲退出; 源未起时 reconnect() 轻量探活等待, 不狂刷 ffmpeg
# v2.1 第二路(背面)就绪后, 在下行末尾追加: --rtsp2 rtsp://<cam2-ip>:8554/live0  (不加=单路, 零影响)
ExecStart=/usr/bin/python3 /data/soph_SN/sn_monitor.py --rtsp rtsp://192.168.1.9:8554/live0 --idle 0 --mi 5
Restart=always
RestartSec=5
# stop 时发 SIGINT -> v9 干净退出(release 发 TEARDOWN)
KillSignal=SIGINT
TimeoutStopSec=15
StandardOutput=append:/data/soph_SN/logs/sn_monitor.service.log
StandardError=append:/data/soph_SN/logs/sn_monitor.service.log

[Install]
WantedBy=multi-user.target

[Unit]
Description=SN preview ffmpeg push (dual sub-stream -> MediaMTX)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# 正面子码流(.9) + 背面子码流(.8) 同时在板内推流
# h264_bm only works with BM1688 HW decoder output (no pipe:0)
#
# ★ 为什么不再内联 `set -m; ffmpeg A & ffmpeg B & wait`:
#   那样写任一路 ffmpeg 退出后, `wait` 只等**剩下的**那个, 不会重拉已退出的那路;
#   而 systemd 看到 bash 外壳还活着, 就认为单元健康 -> 永久单路(现场"背面没视频"
#   而单元 state=active/NRestarts 不增, 正是此因)。
#   ffmpeg 遇流抖动是**直接退出**, python reader 是**重试** —— 这解释了同一台相机
#   上两种客户端的不对称。改由监督脚本各自记账、谁退重拉谁。
ExecStart=/bin/bash /data/soph_SN/deploy/preview_supervisor.sh
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
# enable monitor 时自动 enable 本单元
WantedBy=sn-monitor.service sn-monitor-big.service multi-user.target
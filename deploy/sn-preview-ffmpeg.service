[Unit]
Description=SN preview ffmpeg push (camera sub-stream -> MediaMTX)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# 主码流 live0 (4K HEVC) → HW decoder → scale 1080p → HW H264 → RTMP → .57
# 与识别(live0)共享同一码流——相机支持多客户端同时拉
ExecStart=/opt/sophon/sophon-ffmpeg_2.2.0/bin/ffmpeg \
  -rtsp_transport tcp -i rtsp://192.168.1.9:8554/live1 \
  -an -c:v h264_bm -b:v 2M -g 30 -bf 0 \
  -f flv rtmp://10.80.40.57:1935/cam_front
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
# ★ V3.0.1: enable monitor 时自动 enable 本单元（仍可单独 enable / disable）
WantedBy=sn-monitor.service sn-monitor-big.service multi-user.target